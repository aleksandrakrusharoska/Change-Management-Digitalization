# --- Jira ---
JIRA_BASE_URL=https://aleksandrakrusaroska812.atlassian.net
JIRA_EMAIL=aleksandrakrusaroska812@gmail.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=SAC

# --- AI (Vercel AI Gateway) ---
# When deployed on Vercel, auth is automatic via OIDC — you can leave the key empty.
# For local dev, create a key at https://vercel.com/dashboard (AI Gateway) and paste it here.
AI_GATEWAY_API_KEY=your-ai-gateway-key-here
# Any model the gateway supports, e.g. anthropic/claude-sonnet-4.5, openai/gpt-4.1, google/gemini-2.5-pro
AI_MODEL=anthropic/claude-sonnet-4.5

# --- Security: a shared secret so only your Power Automate flow can call this endpoint ---
WEBHOOK_SECRET=choose-a-long-random-string
